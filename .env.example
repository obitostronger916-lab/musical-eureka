# Telegram bot token from BotFather. Never commit a real token.
BOT_TOKEN=
# Numeric Telegram user ID of the primary administrator.
ADMIN_ID=
# PostgreSQL connection URL supplied by your hosting provider.
DATABASE_URL=
# Optional: AudD API token for voice/audio/video song recognition.
AUDD_API_TOKEN=
# Optional: Musixmatch API key for searching by a short lyric excerpt.
MUSIXMATCH_API_KEY=
# Telegram Bot API download limit: 1-20 MB (default 15).
MAX_MEDIA_FILE_MB=15
APP_NAME=Universal Media
LOG_LEVEL=INFO
